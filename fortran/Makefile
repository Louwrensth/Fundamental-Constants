
THIS_DIR := $(dir $(abspath $(firstword $(MAKEFILE_LIST))))
include ../Makefile.common

# Files generated by mk_fortran.py
FORTRAN_SOURCES = \
mathematical_constants.f90 \
physical_constants_2002.f90 \
physical_constants_2006.f90 \
physical_constants_2010.f90 \
physical_constants_2014.f90 \
physical_constants_2018.f90 \

PC_FILES = imas-constants-fortran.pc

all: $(FORTRAN_SOURCES) pkgconfig

clean: pkgconfig_clean
	$(RM) $(FORTRAN_SOURCES)

install: $(FORTRAN_SOURCES) pkgconfig_install
	$(MKDIR_P) $(DESTDIR)$(includedir)
	$(INSTALL_DATA) $(FORTRAN_SOURCES) $(DESTDIR)$(includedir)

# Mulitple files generated by single script
$(FORTRAN_SOURCES): fortran_sources
.PHONY: fortran_sources
fortran_sources:
	$(PYTHON) mk_fortran.py

include ../Makefile.pkgconfig
